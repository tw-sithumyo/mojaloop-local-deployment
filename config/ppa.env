# Tazama Mojaloop Payment Platform Adapter local defaults.
#
# The scripts look for the PPA repository in one of:
# - $PPA_HOME
# - $ROOT_DIR/Tazama/payment-platform-adapter
# - $ROOT_DIR/payment-platform-adapter
#
# Important: the current upstream PPA consumes only one Kafka topic at a time.
# For local Mojaloop, quote and transfer audit events live on different topics.
# Start with one topic and change this value as needed while testing.

PPA_HOST=127.0.0.1
PPA_PORT=3500

FUNCTION_NAME=payment_platform_adapter
NODE_ENV=dev

KAFKA_URI=127.0.0.1:9092
KAFKA_CLIENT_ID=mojaloop-local-ppa
KAFKA_CONSUMER_GROUP=mojaloop-local-ppa
KAFKA_TOPIC_TO_CONSUME=topic-quotes-post

REDIS_URL=127.0.0.1
REDIS_PORT=6379
