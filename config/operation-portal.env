# Operation Portal local defaults.
#
# The API reads DB/Mongo/Redis/S3 config from Vault. The local helper starts a
# dev Vault container and seeds these values for the host-run API process.

OPERATION_PORTAL_PORT=8003
OPERATION_PORTAL_FRONTEND_ENDPOINT=http://127.0.0.1:4180
OPERATION_PORTAL_REPORT_PAGE_SIZE=100000

OPERATION_PORTAL_VAULT_CONTAINER=local-operation-portal-vault
OPERATION_PORTAL_VAULT_IMAGE=hashicorp/vault:1.15
OPERATION_PORTAL_VAULT_ADDR=http://127.0.0.1:8200
OPERATION_PORTAL_VAULT_TOKEN=root-token
OPERATION_PORTAL_ENGINE_PATH=operation_portal

OPERATION_PORTAL_REDIS_URL=redis://127.0.0.1:6379

OPERATION_PORTAL_DB_HOST=127.0.0.1
OPERATION_PORTAL_DB_PORT=3306
OPERATION_PORTAL_DB_NAME=operation_portal
OPERATION_PORTAL_DB_USERNAME=operation_portal_jdbc
OPERATION_PORTAL_DB_PASSWORD=password
OPERATION_PORTAL_DB_READ_USERNAME=operation_portal_ro
OPERATION_PORTAL_DB_READ_PASSWORD=password
OPERATION_PORTAL_DB_FLYWAY_USERNAME=root
OPERATION_PORTAL_DB_FLYWAY_PASSWORD=
OPERATION_PORTAL_DB_POOL_MIN=5
OPERATION_PORTAL_DB_POOL_MAX=10

OPERATION_PORTAL_HUB_DB_HOST=127.0.0.1
OPERATION_PORTAL_HUB_DB_PORT=3306
OPERATION_PORTAL_HUB_DB_NAME=central_ledger
OPERATION_PORTAL_HUB_DB_USERNAME=central_ledger
OPERATION_PORTAL_HUB_DB_PASSWORD=password
OPERATION_PORTAL_HUB_DB_POOL_MIN=5
OPERATION_PORTAL_HUB_DB_POOL_MAX=10

OPERATION_PORTAL_MONGO_URI=mongodb://127.0.0.1:27017
OPERATION_PORTAL_MONGO_DATABASE=reporting
OPERATION_PORTAL_MONGO_READ_PREFERENCE=primary

OPERATION_PORTAL_S3_ENABLED=false
OPERATION_PORTAL_S3_BUCKET=local-operation-portal
OPERATION_PORTAL_S3_ACCESS_KEY=placeholder
OPERATION_PORTAL_S3_SECRET_KEY=placeholder
OPERATION_PORTAL_S3_REGION=us-east-1
OPERATION_PORTAL_S3_PREFIX=reports/
OPERATION_PORTAL_S3_ENDPOINT=
OPERATION_PORTAL_S3_PATH_STYLE_ACCESS=true
OPERATION_PORTAL_S3_PRESIGNED_URL_LIFETIME=PT15M
