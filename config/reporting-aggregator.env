# Reporting Aggregator local defaults.
#
# The scripts look for the repository in one of:
# - $REPORTING_AGGREGATOR_HOME
# - $ROOT_DIR/reporting-aggregator-svc
#
# Set REPORTING_MONGO_MANAGED=1 to let the local scripts run MongoDB in Docker.
# Leave it as 0 if you already have a MongoDB instance running elsewhere.

LOG_LEVEL=info

REPORTING_MYSQL_DB_HOST=127.0.0.1
REPORTING_MYSQL_DB_PORT=3306
REPORTING_MYSQL_DB_USER=central_ledger
REPORTING_MYSQL_DB_PASSWORD=password
REPORTING_MYSQL_DB_SCHEMA=central_ledger

REPORTING_MONGO_DB_HOST=127.0.0.1
REPORTING_MONGO_DB_PORT=27017
REPORTING_MONGO_DB_USER=
REPORTING_MONGO_DB_PASSWORD=
REPORTING_MONGO_DB_DATABASE=reporting

BATCH_SIZE=10000
TRANSFER_DETAILS_BATCH_SIZE=10000
LOOP_TIMEOUT=5000
MIN_BATCH_PERCENTAGE=70
MAX_WAIT_COUNT=3

REPORTING_MONGO_MANAGED=0
REPORTING_MONGO_IMAGE=mongo:6
REPORTING_MONGO_CONTAINER=local-reporting-mongo
