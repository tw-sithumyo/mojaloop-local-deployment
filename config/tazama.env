# Tazama local launcher defaults.
#
# The scripts look for the Full-Stack-Docker-Tazama repository in one of:
# - $TAZAMA_STACK_ROOT
# - $ROOT_DIR/Tazama/Full-Stack-Docker-Tazama
# - $ROOT_DIR/Full-Stack-Docker-Tazama

# public-github | public-dockerhub | full-dockerhub | multitenant
TAZAMA_STACK_TYPE=public-dockerhub

# Full-Stack-Docker-Tazama consumes this for DockerHub image tags.
TAZAMA_VERSION=rc

# Compose project name.
TAZAMA_PROJECT_NAME=tazama

# Optional addons.
TAZAMA_ENABLE_AUTH=0
TAZAMA_ENABLE_RELAY=1
TAZAMA_ENABLE_BASIC_LOGS=0
TAZAMA_ENABLE_UI=0
TAZAMA_ENABLE_NATS_UTILS=0
TAZAMA_ENABLE_BATCH_PPA=0
TAZAMA_ENABLE_PGADMIN=0
TAZAMA_ENABLE_HASURA=0

# Exposed service ports.
TMS_PORT=5000
ADMIN_PORT=5100
POSTGRES_PORT=15432
PGADMIN_PORT=15050
APMSERVER_PORT=8200
ES_PORT=9200
EVENT_SIDECAR_PORT=15000
KIBANA_PORT=5601
